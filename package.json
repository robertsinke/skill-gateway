{
  "name": "skill-gateway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:ui": "vite build --ssr entry-server.ts --outDir ../../dist/ui-server --emptyOutDir && vite build && node scripts/render-page.js",
    "build": "npm run build:ui && tsc",
    "start:mcp:http": "node dist/http-mcp.js",
    "sync:codex-pointers": "node --experimental-strip-types scripts/sync-codex-skill-pointers.ts",
    "build:usage-dataset": "node --experimental-strip-types scripts/build-usage-turn-dataset.ts",
    "eval:skill-runtime": "node --experimental-strip-types scripts/evaluate-skill-runtime.ts",
    "eval:skill-runtime:batch": "node --experimental-strip-types scripts/score-skill-runtime-experiment.ts",
    "eval:skill-rerank": "node --experimental-strip-types scripts/evaluate-skill-rerank.ts",
    "test": "npm run build:ui && node --experimental-strip-types --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig src/ui/tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  }
}
